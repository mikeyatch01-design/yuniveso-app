# Copy this file to .env and fill in real values. Never commit the real .env.

# MySQL connection — Railway provides these on the MySQL service's "Variables" tab.
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=railway

# Random long string used to sign login tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Port the web server listens on. Railway sets this automatically in production.
PORT=8080
